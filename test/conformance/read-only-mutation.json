{
  "tool": "venom-echo",
  "read": {
    "args": [
      "echo",
      "--text=hi"
    ],
    "result": {
      "text": "hi"
    },
    "mcp": {
      "name": "echo",
      "arguments": {
        "text": "hi"
      }
    }
  },
  "usage_error": {
    "args": [
      "echo",
      "--style=loud",
      "--text=hi"
    ],
    "code": "invalid_params.enum"
  },
  "mutation": {
    "args": [
      "counter",
      "get"
    ],
    "result": {
      "value": 1
    },
    "mcp": {
      "name": "counter_dget",
      "arguments": {}
    },
    "observe": {
      "args": [
        "counter",
        "get"
      ],
      "before": {
        "value": 0
      },
      "after": {
        "value": 1
      }
    }
  },
  "stream": {
    "args": [
      "sleep",
      "--ms=20",
      "--ticks=3"
    ],
    "items": [
      {
        "tick": 1
      },
      {
        "tick": 2
      },
      {
        "tick": 3
      }
    ],
    "slow_args": [
      "sleep",
      "--ms=50",
      "--ticks=1000"
    ],
    "error_args": [
      "sleep",
      "--ms=10",
      "--ticks=3",
      "--fail-at=2"
    ],
    "error_code": "failed.sleep_aborted"
  },
  "config": {
    "key": "appearance.prefix",
    "default": "\"\"",
    "value": "\"conf:\"",
    "observe": {
      "args": [
        "echo",
        "--text=x"
      ],
      "before": {
        "text": "x"
      },
      "after": {
        "text": "conf:x"
      }
    },
    "secret_key": "api_token"
  }
}
