.{
    .{
        .name = "secrets.set",
        .summary = "Store a secret, encrypted at rest",
        .params = .{
            .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
            .{ .name = "value", .summary = "Secret value", .type = .{ .kind = .string }, .required = true },
        },
        .result = .{
            .kind = .object,
            .fields = .{
                .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
                .{ .name = "created", .summary = "True if the secret did not exist before", .type = .{ .kind = .boolean }, .required = true },
            },
        },
        .errors = .{
            .{ .code = "invalid_params.secret_name", .summary = "Name is not [A-Za-z0-9][A-Za-z0-9._-]{0,63}" },
            .{ .code = "invalid_params.secret_too_large", .summary = "Value exceeds 64 KiB" },
            .{ .code = "conflict.secrets_full", .summary = "The store already holds 1024 secrets" },
        },
        .grant = .admin,
    },
    .{
        .name = "secrets.get",
        .summary = "Read a secret's value",
        .params = .{
            .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
        },
        .result = .{
            .kind = .object,
            .fields = .{
                .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
                .{ .name = "value", .summary = "Secret value", .type = .{ .kind = .string }, .required = true },
            },
        },
        .errors = .{
            .{ .code = "not_found.secret", .summary = "No secret by that name" },
        },
        .grant = .admin,
    },
    .{
        .name = "secrets.list",
        .summary = "List secret names (never values)",
        .result = .{
            .kind = .object,
            .fields = .{
                .{ .name = "names", .summary = "Secret names, sorted", .type = .{ .kind = .array, .items = .{ .kind = .string } }, .required = true },
            },
        },
        .grant = .admin,
    },
    .{
        .name = "secrets.rm",
        .summary = "Delete a secret",
        .params = .{
            .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
        },
        .result = .{
            .kind = .object,
            .fields = .{
                .{ .name = "name", .summary = "Secret name", .type = .{ .kind = .string }, .required = true },
                .{ .name = "removed", .summary = "False if there was no secret by that name", .type = .{ .kind = .boolean }, .required = true },
            },
        },
        .grant = .admin,
    },
}
